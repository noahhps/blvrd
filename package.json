    "pdfjs-dist": "6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-icons": "^16.34.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-react": "^4.3.4",
